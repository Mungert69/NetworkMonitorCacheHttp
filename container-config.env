# Container Configuration for Flask Cache Server
# This file defines the container settings similar to .csproj properties

# Container Image Tag
CONTAINER_TAG=1.0.0

# Container Repository
CONTAINER_REPO=mungert/networkmonitorcachehttp

# Container Name
CONTAINER_NAME=cachehttp

# Default API Key (can be overridden by domain-env)
DEFAULT_API_KEY=change-me-in-production

# Default Port
DEFAULT_PORT=5000

# Cache Directory
CACHE_DIR=./cache_files

# Max File Size (in bytes)
MAX_FILE_SIZE=524288000

# Log Level
LOG_LEVEL=INFO